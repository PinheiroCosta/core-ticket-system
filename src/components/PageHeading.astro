---
const { eyebrow, title, description } = Astro.props;
---

<div class="heading">
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h1>{title}</h1>
  {description && <p class="description">{description}</p>}
</div>

<style>
  .heading {
    margin-bottom: 2rem;
  }

  .eyebrow {
    margin: 0 0 0.5rem;
    color: #3164d8;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.25rem);
    line-height: 1.05;
  }

  .description {
    max-width: 42rem;
    margin: 1rem 0 0;
    color: #5f6b7a;
    font-size: 1.1rem;
    line-height: 1.6;
  }
</style>
