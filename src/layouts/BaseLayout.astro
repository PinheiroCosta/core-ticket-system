---
const { title = "Core Ticket System" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Core Ticket System administration" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">Core Ticket System</a>
      <nav aria-label="Primary navigation">
        <a href="/dashboard">Dashboard</a>
        <a href="/login">Sign in</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    font-family:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI",
      sans-serif;
    color: #172033;
    background: #f5f7fb;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
  }

  a {
    color: inherit;
  }

  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.25rem 1.5rem;
  }

  .brand {
    font-weight: 700;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 1rem;
    font-size: 0.95rem;
  }

  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 1.5rem 4rem;
  }

  .panel {
    padding: 2rem;
    border: 1px solid #dfe5ef;
    border-radius: 0.75rem;
    background: #fff;
    box-shadow: 0 8px 24px rgb(23 32 51 / 6%);
  }

  .muted {
    color: #5f6b7a;
  }

  @media (max-width: 600px) {
    .site-header {
      align-items: flex-start;
      gap: 1rem;
      flex-direction: column;
    }

    main {
      padding-top: 1rem;
    }
  }
</style>
